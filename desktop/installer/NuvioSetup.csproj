<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>NuvioSetup</AssemblyName>
    <RootNamespace>Installer</RootNamespace>
    <ApplicationIcon>..\..\composeApp\desktop-icons\nuvio.ico</ApplicationIcon>
    <Company>Nuvio</Company>
    <Product>Nuvio Setup</Product>
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\composeApp\desktop-icons\nuvio.ico" Link="Assets\icon.ico" />
    <EmbeddedResource Include="Assets\payload.zip" Condition="Exists('Assets\payload.zip')" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
